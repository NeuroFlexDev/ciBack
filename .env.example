ENV=dev
DEBUG=true
LOG_LEVEL=INFO

APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=./uploads
MAX_DOCUMENT_SIZE_MB=25
CHAT_HISTORY_MESSAGES=20
DOCUMENT_CHUNK_CHARS=2000
DOCUMENT_CHUNK_OVERLAP_CHARS=200
GRAPH_CONTEXT_MAX_CHARS=60000
EMBEDDING_MODEL=all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=sqlite:///./database.db

JWT_SECRET=replace-with-a-random-local-secret
JWT_ALG=HS256
REGISTRATION_ENABLED=true
PUBLIC_APP_URL=http://localhost:5173
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20
REDIS_URL=redis://localhost:6379/0
SMTP_FROM=
SMTP_STARTTLS=true
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=1440

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

HUGGINGCHAT_PROXY_URL=http://ml-proxy:8001
HF_TOKEN=
HF_MODEL=
HF_MODEL_CANDIDATES=
HF_API_URL=

GIGA_CLIENT_ID=
GIGA_CLIENT_SECRET=
GIGA_SCOPE=GIGACHAT_API_PERS

# Docker Compose uses these values to create its local PostgreSQL service.
POSTGRES_USER=ciuser
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=cidb

# VSELLM / LangGraph agents (never commit real API keys)
VSELLM_API_KEY=
VSELLM_BASE_URL=https://api.vsellm.ru/v1
AI_MODEL_FAST=openai/gpt-5.4-mini
AI_MODEL_REASONING=openai/gpt-5.4-mini
AI_MODEL_WRITER=openai/gpt-5.4-mini
AI_MODEL_CRITIC=anthropic/claude-sonnet-4.6
AI_MODEL_FALLBACK=google/gemini-2.5-flash
AI_MODEL_EMBEDDING=openai/text-embedding-3-small
AI_MAX_TOKENS_PER_RUN=600000
AI_MAX_CALLS_PER_RUN=180
AI_MAX_REVISIONS=2
AI_QA_MIN_SCORE=0.8

# Always route normal calls; additional provider/models require explicit approval.
# See AI_ROUTING.md. Run alembic upgrade head before starting the app.
AI_ROUTING_MODE=adaptive
AI_ROUTING_CANDIDATES=[]
AI_ROUTING_MIN_SAMPLES=10
AI_ROUTING_MIN_PASS_RATE=0.85
AI_ROUTING_HISTORY_LIMIT=200
AI_ROUTING_COOLDOWN_SECONDS=300

# OpenAI-compatible providers: endpoint + environment variable name, never a key in JSON.
AI_PROVIDERS=[]
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_TOKEN_FORECAST_PATH=app/ai/data/token_forecast.json
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Separate collection gate for unapproved test environments.
CONTACT_REQUESTS_ENABLED=false

# Material safety and independent AI endpoints. Providers below must already be
# present in AI_PROVIDERS; disabled/missing providers return explicit 503.
AI_LOCAL_ONLY=false
EMBEDDING_PROVIDER=vsellm
IMAGE_PROVIDER=
IMAGE_MODEL=
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=20000000
IMAGE_MONTHLY_LIMIT=50
AI_CHAT_MONTHLY_LIMIT=1000
AI_CHAT_RETENTION_DAYS=90
DOCUMENT_MAX_UNPACKED_BYTES=104857600
DOCUMENT_MAX_ARCHIVE_ENTRIES=5000
DOCUMENT_MAX_PAGES=1000
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=120
DOCUMENT_MAX_EXTRACTED_CHARS=2000000
MAX_COURSE_MODULES=100
MAX_COURSE_LESSONS=500
MAX_LESSON_CONTENT_CHARS=200000

# Resource reservations are atomic across all API/worker processes.
# Organization defaults can be overridden per customer in the operator UI.
# Missing remote image/embedding prices DISABLE paid dispatch (not zero cost).
# Set approved supplier rates; never infer them from a text-model price.
IMAGE_PRICE_RUB=
EMBEDDING_RUB_PER_MILLION=
AI_ORG_QUEUED_LIMIT=8
AI_INSTALL_QUEUED_LIMIT=64
AI_ORG_BACKGROUND_LIMIT=2
AI_INSTALL_BACKGROUND_LIMIT=4
AI_ORG_INTERACTIVE_LIMIT=4
AI_INSTALL_INTERACTIVE_LIMIT=16
AI_ORG_MONTHLY_TOKENS=20000000
AI_INSTALL_MONTHLY_TOKENS=200000000
AI_ORG_MONTHLY_OCR_PAGES=10000
AI_INSTALL_MONTHLY_OCR_PAGES=100000
AI_ORG_MONTHLY_RUB=10000
AI_INSTALL_MONTHLY_RUB=100000
AI_MAX_RUB_PER_RUN=1000

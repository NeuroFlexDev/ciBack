ENV=dev
DEBUG=true
LOG_LEVEL=INFO

APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=./uploads
MAX_DOCUMENT_SIZE_MB=25
CHAT_HISTORY_MESSAGES=20
DOCUMENT_CHUNK_CHARS=2000
DOCUMENT_CHUNK_OVERLAP_CHARS=200
GRAPH_CONTEXT_MAX_CHARS=60000
EMBEDDING_MODEL=all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=sqlite:///./database.db

JWT_SECRET=replace-with-a-random-local-secret
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=1440

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

HUGGINGCHAT_PROXY_URL=http://ml-proxy:8001
HF_TOKEN=
HF_MODEL=
HF_MODEL_CANDIDATES=
HF_API_URL=

GIGA_CLIENT_ID=
GIGA_CLIENT_SECRET=
GIGA_SCOPE=GIGACHAT_API_PERS

# Docker Compose uses these values to create its local PostgreSQL service.
POSTGRES_USER=ciuser
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=cidb

# VSELLM / LangGraph agents (never commit real API keys)
VSELLM_API_KEY=
VSELLM_BASE_URL=https://api.vsellm.ru/v1
AI_MODEL_FAST=openai/gpt-5.4-mini
AI_MODEL_REASONING=openai/gpt-5.4-mini
AI_MODEL_WRITER=openai/gpt-5.4-mini
AI_MODEL_CRITIC=anthropic/claude-sonnet-4.6
AI_MODEL_FALLBACK=google/gemini-2.5-flash
AI_MODEL_EMBEDDING=openai/text-embedding-3-small
AI_MAX_TOKENS_PER_RUN=600000
AI_MAX_CALLS_PER_RUN=180
AI_MAX_REVISIONS=2
AI_QA_MIN_SCORE=0.8

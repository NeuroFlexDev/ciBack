{$PUBLIC_HOST:dev.platform.lernium.ru} {
    encode zstd gzip

    @backend path /api/* /docs* /openapi.json
    handle @backend {
        reverse_proxy 127.0.0.1:8000
    }

    @landing path / /index.html
    handle @landing {
        rewrite * /index.html
        header Cache-Control "no-cache, no-store, must-revalidate"
        reverse_proxy 127.0.0.1:8081
    }

    @landingAssets path /styles.css /script.js /assets/fonts/* /assets/icons/* /assets/hero-* /assets/cta-*
    handle @landingAssets {
        header Cache-Control "public, max-age=300"
        reverse_proxy 127.0.0.1:8081
    }

    handle {
        reverse_proxy 127.0.0.1:8080
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }

    log {
        output stdout
        format console
    }
}

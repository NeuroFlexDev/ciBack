{$PUBLIC_HOST:dev.platform.lernium.ru} {
    encode zstd gzip

    # A demo must remain crawlable for crawlers to observe the noindex header.
    @nonProduction not host lernium.ru
    header @nonProduction X-Robots-Tag "noindex, nofollow, noarchive"
    @privatePages path /company /company/* /auth /auth/* /admin /admin/* /invite /invite/* /dashboard /dashboard/* /account /account/* /forgot-password /reset-password /courses /courses/* /employees /analytics /express /templates /ai-helper /learning /learning/* /reviews /reviews/* /course-reviews /groups /groups/* /assignments /programs /programs/* /team-settings /support-access /learning-analytics /integrations /integrations/* /billing /results /notifications /help
    header @privatePages X-Robots-Tag "noindex, nofollow"
    @appleAssociation path /.well-known/apple-app-site-association
    handle @appleAssociation {
        root * /associations
        rewrite * /apple-app-site-association
        header Content-Type application/json
        header Cache-Control "public, max-age=300"
        file_server
    }
    @androidAssociation path /.well-known/assetlinks.json
    handle @androidAssociation {
        root * /associations
        rewrite * /assetlinks.json
        header Content-Type application/json
        header Cache-Control "public, max-age=300"
        file_server
    }
    @demoRobots {
        path /robots.txt
        not host lernium.ru
    }
    handle @demoRobots {
        header Content-Type "text/plain; charset=utf-8"
        respond "User-agent: *" 200
    }
    @demoSitemap {
        path /sitemap.xml
        not host lernium.ru
    }
    handle @demoSitemap {
        respond 404
    }
    redir /index.html / 301

    @backend path /api/*
    handle @backend {
        reverse_proxy 127.0.0.1:8000
    }

    @landing path /
    handle @landing {
        rewrite * /index.html
        header Cache-Control "no-cache, no-store, must-revalidate"
        reverse_proxy 127.0.0.1:8081
    }

    @landingAssets path /styles.css /script.js /robots.txt /sitemap.xml /assets/fonts/* /assets/icons/* /assets/hero-* /assets/cta-*
    handle @landingAssets {
        reverse_proxy 127.0.0.1:8081
    }

    handle {
        reverse_proxy 127.0.0.1:8080
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }

    log {
        output stdout
        format console
    }
}


{$ADMIN_HOST:admin.dev.lernium.ru} {
    encode zstd gzip
    header {
        -Server
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Cache-Control no-store
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8002
    }
    handle {
        reverse_proxy 127.0.0.1:8082
    }
}

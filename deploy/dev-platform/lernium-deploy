#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly deployment_dir="/opt/lernium/deploy"
readonly images_file="${deployment_dir}/.images.env"
readonly backup_dir="/opt/lernium/backups"
readonly rollback_profile="${deployment_dir}/.rollback-profile"

fail() {
    printf 'Deployment failed: %s\n' "$*" >&2
    exit 1
}

[[ ${EUID} -eq 0 ]] || fail "must run as root"
[[ $# -eq 3 || $# -eq 4 ]] || fail "usage: lernium-deploy <backend|frontend|landing> <image> <ghcr-user> [health-url]"

component="$1"
image="$2"
ghcr_user="$3"
health_url="${4:-https://dev.platform.lernium.ru}"

case "${component}" in
    backend)
        image_variable="BACKEND_IMAGE"
        expected_repository="ciback"
        ;;
    frontend)
        image_variable="FRONTEND_IMAGE"
        expected_repository="cifront"
        ;;
    landing)
        image_variable="LANDING_IMAGE"
        expected_repository="cilanding"
        ;;
    *)
        fail "unknown component ${component}"
        ;;
esac

[[ "${image}" =~ ^ghcr\.io/neuroflexdev/${expected_repository}:sha-[0-9a-f]{40}$ ]] || fail "invalid image reference"
[[ "${ghcr_user}" =~ ^[A-Za-z0-9-]+$ ]] || fail "invalid GHCR user"
[[ "${health_url}" =~ ^https://[A-Za-z0-9.-]+$ ]] || fail "invalid health URL"
[[ -d "${deployment_dir}" ]] || fail "deployment directory is missing"
[[ -f "${deployment_dir}/.env" ]] || fail "deployment environment is missing"

ghcr_token=""
IFS= read -r ghcr_token || true
[[ -n "${ghcr_token}" ]] || fail "GHCR token was not provided on stdin"

install -d -m 0700 "${backup_dir}"
touch "${images_file}"
chmod 0600 "${images_file}"

ensure_image_variable() {
    local variable="$1"
    local default_value="$2"
    if ! grep -q "^${variable}=" "${images_file}"; then
        printf '%s=%s\n' "${variable}" "${default_value}" >> "${images_file}"
    fi
}

ensure_image_variable BACKEND_IMAGE lernium-backend:latest
ensure_image_variable FRONTEND_IMAGE lernium-frontend:latest
ensure_image_variable LANDING_IMAGE lernium-landing:latest


set_image() {
    local variable="$1"
    local value="$2"
    local temporary_file
    temporary_file="$(mktemp "${deployment_dir}/.images.env.XXXXXX")"
    awk -F= -v key="${variable}" -v replacement="${value}" '
        BEGIN { updated = 0 }
        $1 == key { print key "=" replacement; updated = 1; next }
        { print }
        END { if (!updated) print key "=" replacement }
    ' "${images_file}" > "${temporary_file}"
    chmod 0600 "${temporary_file}"
    mv -f "${temporary_file}" "${images_file}"
}

compose() {
    docker compose \
        --file "${deployment_dir}/docker-compose.yml" \
        --project-directory "${deployment_dir}" \
        --env-file "${deployment_dir}/.env" \
        --env-file "${images_file}" \
        "$@"
}

# Primitives available in the previous release make the first upgrade drainable.
drain_control() {
    compose exec -T backend python - "$ai_drain_token" "$1" <<'PY_DRAIN'
import sys
from datetime import datetime
from redis import Redis
from sqlalchemy import func
from app.core.config import settings
from app.database.db import SessionLocal
from app.models.ai_resources import AIResourceUsage
from app.services.ai_resources import locked
client = Redis.from_url(settings.REDIS_URL, socket_connect_timeout=3, socket_timeout=3)
lease = "lernium:deployment:ai-drain"
token, mode = sys.argv[1:3]
if mode == "end":
    client.eval("if redis.call('GET', KEYS[1]) == ARGV[1] then return redis.call('DEL', KEYS[1], KEYS[2]) else return 0 end", 2, lease, "rq:suspended", token)
else:
    with SessionLocal() as db:
        if mode == "begin":
            locked(db)
            acquired = client.eval("if redis.call('EXISTS', KEYS[2]) == 1 then return 0 end; redis.call('SET', KEYS[1], ARGV[1], 'EX', 900); redis.call('SET', KEYS[2], '1', 'EX', 900); return 1", 2, lease, "rq:suspended", token)
            if not acquired:
                raise SystemExit("AI workers are already suspended; existing suspension preserved")
            db.commit()
        count = db.query(func.count(AIResourceUsage.id)).filter(AIResourceUsage.lane == "background", AIResourceUsage.status == "running", AIResourceUsage.expires_at > datetime.utcnow()).scalar()
        print(count)
client.close()
PY_DRAIN
}

drain_background_jobs() {
    local active attempt
    ai_draining=true
    active="$(drain_control begin)" || return 1
    for ((attempt=0; attempt<60; attempt++)); do
        [[ "$active" =~ ^[0-9]+$ ]] || return 1
        if [[ "$active" == 0 ]]; then return 0; fi
        if ((attempt % 6 == 0)); then printf 'Waiting for %s active AI/document jobs before deployment.\n' "$active"; fi
        sleep 5
        active="$(drain_control count)" || return 1
    done
    printf 'Background jobs are still active; keeping the current release running.\n' >&2
    return 1
}

wait_for_url() {
    local url="$1"
    local attempts="${2:-40}"
    local delay="${3:-3}"
    local attempt
    for ((attempt = 1; attempt <= attempts; attempt++)); do
        if curl --fail --silent --show-error --max-time 5 "${url}" >/dev/null; then
            return 0
        fi
        sleep "${delay}"
    done
    return 1
}

# Derive all long-running services sharing this backend image, including outbox
# and future worker pools. Never print the resolved Compose document: it has secrets.
backend_service_names() {
    compose config --format json | python3 -c '
import json,re,sys
services=json.load(sys.stdin)["services"]
image=services["backend"]["image"]
names=sorted(name for name, service in services.items()
    if service.get("image")==image and service.get("restart") in {"always","unless-stopped","on-failure"})
if "backend" not in names or "worker" not in names or any(not re.fullmatch(r"[a-z][a-z0-9_-]*",name) for name in names):
    raise SystemExit("Invalid backend service set")
if any(not services[name].get("healthcheck",{}).get("test") or services[name]["healthcheck"].get("disable") for name in names):
    raise SystemExit("Every backend worker must declare a healthcheck")
print("\n".join(names))'
}

deploy_current_image() {
    case "${component}" in
        backend)
            compose pull "${backend_services[@]}" migrate || return 1
            compose up -d --wait --wait-timeout 120 db redis || return 1
            compose exec -T db sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' \
                > "${backup_dir}/database-$(date -u +%Y%m%dT%H%M%SZ).dump" || return 1
            compose run --rm --no-deps migrate || return 1
            if [[ -f "${deployment_dir}/.legacy-pending" ]]; then /usr/local/sbin/lernium-import-legacy || return 1; fi
            compose up -d --no-deps --force-recreate --wait --wait-timeout 180 "${backend_services[@]}" || return 1
            wait_for_url http://127.0.0.1:8000/api/readiness || return 1
            if [[ ! -f "${deployment_dir}/.bootstrap-pending" ]]; then wait_for_url "${health_url}/api/readiness" || return 1; fi
            ;;
        frontend)
            compose pull "${frontend_services[@]}" || return 1
            compose up -d --no-deps --force-recreate --wait --wait-timeout 90 "${frontend_services[@]}" || return 1
            wait_for_url http://127.0.0.1:8080/healthz || return 1
            if [[ ! -f "${deployment_dir}/.bootstrap-pending" ]]; then wait_for_url "${health_url}/auth" || return 1; fi
            ;;
        landing)
            compose pull landing || return 1
            compose up -d --no-deps --force-recreate landing || return 1
            wait_for_url http://127.0.0.1:8081/healthz || return 1
            if [[ "$edge_mode" == caddy && ! -f "${deployment_dir}/.bootstrap-pending" ]]; then compose up -d --no-deps --force-recreate caddy || return 1; fi
            if [[ ! -f "${deployment_dir}/.bootstrap-pending" ]]; then wait_for_url "${health_url}/" || return 1; fi
            ;;
    esac
}

rollback() {
    printf 'Health check failed; rolling %s back to %s\n' "${component}" "${previous_image}" >&2
    if [[ "$component" == backend ]]; then
        # Freeze enrollment before checking compatibility: otherwise a user can
        # enable MFA after the query and be rolled back to password-only code.
        compose stop --timeout 30 backend || return 1
        rollback_auth_compatible || return 1
    fi
    set_image "${image_variable}" "${previous_image}"
    case "${component}" in
        backend)
            # On the first release an old image may not contain a new worker module.
            # Stop introduced services before restoring the previous configuration/image.
            if ((${#introduced_services[@]})); then compose stop --timeout 30 "${introduced_services[@]}" || return 1; fi
            if [[ "$profile_pending" == true ]]; then
                for name in docker-compose.yml frontend-nginx.conf admin-nginx.conf Caddyfile; do
                    if [[ -f "${rollback_profile}/${name}" ]]; then
                        cp -- "${rollback_profile}/${name}" "${deployment_dir}/${name}"
                    fi
                done
            fi
            compose up -d --no-deps --force-recreate --wait --wait-timeout 180 "${previous_backend_services[@]}" || return 1
            wait_for_url http://127.0.0.1:8000/api/readiness || return 1
            if [[ "$profile_pending" == true && "$edge_mode" == caddy ]]; then
                compose up -d --no-deps --force-recreate caddy || return 1
            fi
            ;;
        frontend)
            if ((${#introduced_frontend_services[@]})); then compose stop --timeout 15 "${introduced_frontend_services[@]}" || return 1; fi
            compose up -d --no-deps --force-recreate --wait --wait-timeout 90 "${previous_frontend_services[@]}"
            ;;
        landing)
            compose up -d --no-deps --force-recreate landing
            if [[ "$edge_mode" == caddy ]]; then compose up -d --no-deps --force-recreate caddy; fi
            ;;
    esac
}

rollback_auth_compatible() {
    local table enabled enforced
    table="$(compose exec -T db sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atqc "SELECT to_regclass('\''public.user_mfa'\'')"')" || return 1
    enabled=false
    if [[ -n "$table" ]]; then
        [[ "$table" == user_mfa || "$table" == public.user_mfa ]] || return 1
        enabled="$(compose exec -T db sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atqc "SELECT EXISTS (SELECT 1 FROM user_mfa WHERE enabled)"')" || return 1
        [[ "$enabled" == t || "$enabled" == f ]] || return 1
    fi
    enforced="$(compose config --format json | python3 -c 'import json,sys; print(str(json.load(sys.stdin)["services"]["backend"].get("environment",{}).get("MFA_REQUIRED_FOR_OPERATORS","false")).lower())')" || return 1
    if [[ "$enabled" == t || "$enforced" == true || "$enforced" == 1 ]]; then
        if ! docker run --rm --network none --read-only --memory 128m --cpus .5 --pids-limit 64 \
            --cap-drop ALL --security-opt no-new-privileges:true --entrypoint python "$previous_image" \
            -c 'import importlib.util; raise SystemExit(0 if importlib.util.find_spec("app.services.mfa_service") else 1)'; then
            printf 'Refusing rollback: previous backend lacks MFA while enrolled users or operator enforcement exist. Candidate image reference is retained; operator recovery is required.\n' >&2
            return 1
        fi
    fi
}

exec 9>"/opt/lernium/.deploy.lock"
flock -w 600 9 || fail "another deployment is still running"
previous_image="$(sed -n "s/^${image_variable}=//p" "${images_file}" | tail -n 1)"
[[ -n "${previous_image}" ]] || fail "could not determine the current image"
edge_mode="$(cat "${deployment_dir}/.edge-mode" 2>/dev/null || printf 'caddy')"
profile_pending=false
backend_services=()
previous_backend_services=()
introduced_services=()
frontend_services=(frontend)
previous_frontend_services=(frontend)
introduced_frontend_services=()
if [[ "$component" == frontend ]]; then
    names="$(compose config --format json | python3 -c '
import json,re,sys
services=json.load(sys.stdin)["services"]
names=sorted(n for n,s in services.items() if s.get("image")==services["frontend"]["image"] and s.get("restart") in {"always","unless-stopped","on-failure"})
if "frontend" not in names or any(not re.fullmatch(r"[a-z][a-z0-9_-]*",n) for n in names): raise SystemExit("Invalid frontend services")
if any(not services[n].get("healthcheck",{}).get("test") for n in names): raise SystemExit("Every frontend needs a healthcheck")
print("\n".join(names))')" || fail "could not identify frontend services"
    mapfile -t frontend_services <<< "$names"
    running="$(compose ps --services --status running)" || fail "could not inspect frontend services"
    previous_frontend_services=()
    for service in "${frontend_services[@]}"; do
        if grep -qxF "$service" <<< "$running"; then previous_frontend_services+=("$service")
        else introduced_frontend_services+=("$service"); fi
    done
    if ((${#previous_frontend_services[@]} == 0)); then previous_frontend_services=(frontend); fi
fi
if [[ "$component" == backend ]]; then
    names="$(backend_service_names)" || fail "could not identify all backend workers"
    mapfile -t backend_services <<< "$names"
    running="$(compose ps --services --status running)" || fail "could not inspect existing services"
    for service in "${backend_services[@]}"; do
        if grep -qxF "$service" <<< "$running"; then previous_backend_services+=("$service")
        else introduced_services+=("$service"); fi
    done
    # A first installation has no prior service set to restore.
    if ((${#previous_backend_services[@]} == 0)); then previous_backend_services=(backend worker); fi
    if [[ -f "${rollback_profile}/.pending" ]]; then
        [[ "$(stat -c %u "$rollback_profile")" == 0 && "$(stat -c %a "$rollback_profile")" == 700 ]] || fail "rollback profile must be root-owned mode 0700"
        [[ -f "${rollback_profile}/docker-compose.yml" && ! -L "${rollback_profile}/docker-compose.yml" ]] || fail "previous Compose profile missing"
        profile_pending=true
    fi
fi


ai_draining=false
ai_drain_token="$(cat /proc/sys/kernel/random/uuid)"
docker_config="$(mktemp -d /tmp/lernium-docker-config.XXXXXX)"
cleanup() {
    if [[ "$ai_draining" == true ]]; then
        drain_control end || printf 'Could not resume AI queue; deployment suspension expires automatically.\n' >&2
    fi
    ghcr_token=""
    rm -rf -- "${docker_config}"
}
trap cleanup EXIT
export DOCKER_CONFIG="${docker_config}"
printf '%s\n' "${ghcr_token}" | docker login ghcr.io --username "${ghcr_user}" --password-stdin >/dev/null
ghcr_token=""

if [[ "$component" == backend ]] && grep -qxF backend <<< "$running"; then
    drain_background_jobs || fail "AI jobs did not drain; release was not changed"
fi
set_image "${image_variable}" "${image}"
if ! deploy_current_image; then
    rollback || fail "${component} failed and rollback readiness failed; operator recovery required"
    fail "${component} did not become healthy"
fi

if [[ "$component" == backend && "$profile_pending" == true ]]; then
    # Preserve the previous files for investigation, but do not reuse a stale rollback automatically.
    mv -- "${rollback_profile}/.pending" "${rollback_profile}/.applied-$(date -u +%Y%m%dT%H%M%SZ)"
fi

if [[ -f "${deployment_dir}/.bootstrap-pending" ]]; then
    if curl -fsS --max-time 5 http://127.0.0.1:8000/api/healthz >/dev/null && \
       curl -fsS --max-time 5 http://127.0.0.1:8080/healthz >/dev/null && \
       curl -fsS --max-time 5 http://127.0.0.1:8081/healthz >/dev/null; then
        if [[ "$edge_mode" == caddy ]]; then compose up -d --no-deps caddy; fi
        wait_for_url "${health_url}/api/healthz"
        wait_for_url "${health_url}/auth"
        rm "${deployment_dir}/.bootstrap-pending"
        printf 'Initial environment is healthy\n'
    else
        printf 'Component is healthy; initial environment awaits remaining components\n'
    fi
fi

printf 'Deployed %s as %s\n' "${component}" "${image}"

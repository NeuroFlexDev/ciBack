POSTGRES_USER=ciuser
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=cidb
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PUBLIC_HOST=dev.platform.lernium.ru

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

HF_TOKEN=
HF_MODEL=
HF_MODEL_CANDIDATES=
HF_API_URL=

GIGA_CLIENT_ID=
GIGA_CLIENT_SECRET=
GIGA_SCOPE=GIGACHAT_API_PERS

# VSELLM / LangGraph agents (never commit real API keys)
VSELLM_API_KEY=
VSELLM_BASE_URL=https://api.vsellm.ru/v1
AI_MODEL_FAST=openai/gpt-5.4-mini
AI_MODEL_REASONING=openai/gpt-5.4-mini
AI_MODEL_WRITER=openai/gpt-5.4-mini
AI_MODEL_CRITIC=anthropic/claude-sonnet-4.6
AI_MODEL_FALLBACK=google/gemini-2.5-flash
AI_MODEL_EMBEDDING=openai/text-embedding-3-small
AI_MAX_TOKENS_PER_RUN=600000
AI_MAX_CALLS_PER_RUN=180
AI_MAX_REVISIONS=2
AI_QA_MIN_SCORE=0.8
AI_ROUTING_MODE=adaptive
AI_ROUTING_CANDIDATES=[]

# Account access and transactional mail
REGISTRATION_ENABLED=false
PUBLIC_APP_URL=https://dev.platform.lernium.ru
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20
# Enable enforcement only after every named operator personally enrolls and saves recovery codes.
MFA_REQUIRED_FOR_OPERATORS=false
MFA_STEP_UP_SECONDS=600
SMTP_FROM=
SMTP_STARTTLS=true

# OpenAI-compatible providers: endpoint + environment variable name, never a key in JSON.
AI_PROVIDERS=[]
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_TOKEN_FORECAST_PATH=app/ai/data/token_forecast.json
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Opt in only after confirming data location and operator readiness.
COMPOSE_PROFILES=edge
CONTACT_REQUESTS_ENABLED=false
CORS_ORIGINS=https://dev.platform.lernium.ru

# Resource reservations are atomic across all API/worker processes.
# Organization defaults can be overridden per customer in the operator UI.
# Missing remote image/embedding prices DISABLE paid dispatch (not zero cost).
# Set approved supplier rates; never infer them from a text-model price.
AI_LOCAL_ONLY=false
IMAGE_PROVIDER=
IMAGE_MODEL=
IMAGE_PRICE_RUB=
EMBEDDING_PROVIDER=vsellm
EMBEDDING_RUB_PER_MILLION=
AI_ORG_QUEUED_LIMIT=8
AI_INSTALL_QUEUED_LIMIT=64
AI_ORG_BACKGROUND_LIMIT=2
AI_INSTALL_BACKGROUND_LIMIT=4
AI_ORG_INTERACTIVE_LIMIT=4
AI_INSTALL_INTERACTIVE_LIMIT=16
AI_ORG_MONTHLY_TOKENS=20000000
AI_INSTALL_MONTHLY_TOKENS=200000000
AI_ORG_MONTHLY_OCR_PAGES=10000
AI_INSTALL_MONTHLY_OCR_PAGES=100000
AI_ORG_MONTHLY_RUB=10000
AI_INSTALL_MONTHLY_RUB=100000
AI_MAX_RUB_PER_RUN=1000

# Copy approved values into the private runtime.env generated by configure.py.
# All backend, worker, outbox and migration containers use that env_file.
# This file contains no credentials and is NOT automatically loaded.
AI_LOCAL_ONLY=false
IMAGE_PROVIDER=
IMAGE_MODEL=
IMAGE_API_MODE=auto
IMAGE_QUALITY=low
# JSON exact HTTPS CDN hostname allowlist. Empty keeps base64-only delivery.
IMAGE_DOWNLOAD_HOSTS=[]
IMAGE_PRICE_RUB=
EMBEDDING_PROVIDER=vsellm
EMBEDDING_RUB_PER_MILLION=
# Empty prices disable remote paid dispatch; local endpoints use zero external
# provider cost and still consume token/page/concurrency quotas.
AI_ORG_QUEUED_LIMIT=8
AI_INSTALL_QUEUED_LIMIT=64
AI_ORG_BACKGROUND_LIMIT=2
AI_INSTALL_BACKGROUND_LIMIT=4
AI_ORG_INTERACTIVE_LIMIT=4
AI_INSTALL_INTERACTIVE_LIMIT=16
AI_ORG_MONTHLY_TOKENS=20000000
AI_INSTALL_MONTHLY_TOKENS=200000000
AI_ORG_MONTHLY_OCR_PAGES=10000
AI_INSTALL_MONTHLY_OCR_PAGES=100000
AI_ORG_MONTHLY_RUB=10000
AI_INSTALL_MONTHLY_RUB=100000
AI_MAX_RUB_PER_RUN=1000
# Organization defaults are overridden in operator Delivery > Materials and AI.
# Installation caps are shared across organizations and cannot be overridden.
# Retention has no implicit deletion policy. Inspect the plan first:
# python -m scripts.purge_ai_history --artifact-days <approved days> --policy-reference <approved ID>
# Execute only the reviewed plan, with the same options plus:
# --execute --plan-digest <digest printed by the dry-run>
# Never use arbitrary retention days in place of an approved customer policy.
